{
  "name": "lanegame-demo-web",
  "private": true,
  "version": "1.0.0",
  "description": "The laning simulator demo: Play against a trained agent, Watch two agents (React, TypeScript, Vite; served by python -m lanegame.demo)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
